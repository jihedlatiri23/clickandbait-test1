<header class="header">
  <div class="container">
    <nav class="nav">
      <a href="/<%= lang %>" class="logo-text">
        <img src="/logo-light.png" alt="" class="logo-icon logo-icon-light">
        <img src="/logo-dark.png" alt="" class="logo-icon logo-icon-dark">
        <div class="logo-wrapper">
          <span class="logo-since">since 2022</span>
          <span class="logo-name"><span class="logo-click">Click</span><span class="logo-nd">nd</span><span class="logo-bait">Bait</span></span>
        </div>
      </a>
      <ul class="nav-links">
        <li><a href="/<%= lang %>" class="<%= page === 'home' ? 'active' : '' %>"><%= t.nav.home %></a></li>
        <li><a href="/<%= lang %>/about" class="<%= page === 'about' ? 'active' : '' %>"><%= t.nav.about %></a></li>
        <li><a href="/<%= lang %>/services" class="<%= page === 'services' ? 'active' : '' %>"><%= t.nav.services %></a></li>
        <li><a href="/<%= lang %>/blog" class="<%= page === 'blog' ? 'active' : '' %>"><%= t.nav.blog %></a></li>
        <li>
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
            <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </li>
        <li class="lang-dropdown">
          <button class="lang-dropdown-btn" id="langDropdownBtn">
            <img src="/flags/<%= lang %>.svg" alt="" class="flag-img">
            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="lang-dropdown-menu" id="langDropdownMenu">
            <a href="/en<%= currentPath %>" class="lang-option <%= lang === 'en' ? 'active' : '' %>">
              <img src="/flags/en.svg" alt="" class="flag-img"> English
            </a>
            <a href="/fr<%= currentPath %>" class="lang-option <%= lang === 'fr' ? 'active' : '' %>">
              <img src="/flags/fr.svg" alt="" class="flag-img"> Français
            </a>
            <a href="/ar<%= currentPath %>" class="lang-option <%= lang === 'ar' ? 'active' : '' %>">
              <img src="/flags/ar.svg" alt="" class="flag-img"> العربية
            </a>
          </div>
        </li>
        <li><a href="/<%= lang %>/contact" class="btn btn-primary"><%= t.nav.contact %></a></li>
      </ul>
    </nav>
  </div>
</header>
