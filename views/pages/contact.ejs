<section class="page-hero">
  <div class="container">
    <h1><%= t.contactPage.title %></h1>
    <p class="hero-subtitle"><%= t.contactPage.subtitle %></p>
  </div>
</section>

<section class="contact-content">
  <div class="container">
    <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success" style="background: #10b981; color: white; padding: 16px; border-radius: 8px; margin-bottom: 24px; text-align: center;">
      <strong>✓ Success!</strong> <%= t.contactPage?.successMessage || 'Thank you for your message. We will get back to you soon!' %>
    </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error" style="background: #ef4444; color: white; padding: 16px; border-radius: 8px; margin-bottom: 24px; text-align: center;">
      <strong>✗ Error!</strong> <%= t.contactPage?.errorMessage || 'There was an error sending your message. Please try again.' %>
    </div>
    <% } %>
    <div class="contact-grid">
      <div class="contact-form-wrapper">
        <form class="contact-form" action="/<%= lang %>/contact" method="POST">
          <div class="form-group">
            <label for="name"><%= t.contactPage.form.name %></label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="form-group">
            <label for="email"><%= t.contactPage.form.email %></label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="form-group">
            <label for="company"><%= t.contactPage.form.company %></label>
            <input type="text" id="company" name="company">
          </div>
          <div class="form-group">
            <label for="message"><%= t.contactPage.form.message %></label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-lg"><%= t.contactPage.form.submit %></button>
        </form>
      </div>
      <div class="contact-info">
        <h3><%= t.contactPage.info.title %></h3>
        <p><strong>Email:</strong> <%= t.contactPage.info.email %></p>
        <p><strong>Phone:</strong> <%= t.contactPage.info.phone %></p>
      </div>
    </div>
  </div>
</section>
