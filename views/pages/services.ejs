<section class="page-hero">
  <div class="container">
    <h1><%= t.servicesPage.title %></h1>
    <p class="hero-subtitle"><%= t.servicesPage.subtitle %></p>
  </div>
</section>

<section class="services-detail">
  <div class="container">
    <% t.servicesPage.details.forEach(function(service, index) { %>
    <div class="service-detail-card">
      <div class="service-detail-icon">
        <% if (index === 0) { %>
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 22L42 10V38L6 26V22Z" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="18" cy="34" r="5" stroke="white" stroke-width="3"/>
        </svg>
        <% } else if (index === 1) { %>
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="10" width="28" height="28" rx="4" stroke="white" stroke-width="3"/>
          <path d="M44 14L32 24L44 34V14Z" fill="white"/>
        </svg>
        <% } else if (index === 2) { %>
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="6" y="28" width="8" height="14" rx="2" fill="white"/>
          <rect x="20" y="18" width="8" height="24" rx="2" fill="white"/>
          <rect x="34" y="8" width="8" height="34" rx="2" fill="white"/>
        </svg>
        <% } else { %>
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 6L6 16L24 26L42 16L24 6Z" stroke="white" stroke-width="3" stroke-linejoin="round"/>
          <path d="M6 24L24 34L42 24" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 32L24 42L42 32" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <% } %>
      </div>
      <div class="service-detail-content">
        <span class="service-badge"><%= t.servicesPage.badge || 'Service' %> 0<%= index + 1 %></span>
        <h2><%= service.title %></h2>
        <p><%= service.description %></p>
        <ul class="service-features-list">
          <% service.features.forEach(function(feature) { %>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <%= feature %>
          </li>
          <% }); %>
        </ul>
      </div>
    </div>
    <% }); %>
  </div>
</section>

<section class="process-section">
  <div class="container">
    <h2><%= t.servicesPage.processTitle || 'How We Work' %></h2>
    <p class="section-subtitle"><%= t.servicesPage.processSubtitle || 'Our proven process delivers results' %></p>
    <div class="process-grid">
      <div class="process-step">
        <div class="process-number">1</div>
        <div class="process-icon">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="white" stroke-width="2"/>
          </svg>
        </div>
        <h3><%= t.servicesPage.process?.[0]?.title || 'Discovery Call' %></h3>
        <p><%= t.servicesPage.process?.[0]?.desc || 'We learn about your business, goals, and challenges' %></p>
      </div>
      <div class="process-step">
        <div class="process-number">2</div>
        <div class="process-icon">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="white" opacity="0.3"/>
            <path d="M2 17L12 22L22 17M2 12L12 17L22 12" stroke="white" stroke-width="2"/>
          </svg>
        </div>
        <h3><%= t.servicesPage.process?.[1]?.title || 'Custom Strategy' %></h3>
        <p><%= t.servicesPage.process?.[1]?.desc || 'We create a tailored plan designed for your success' %></p>
      </div>
      <div class="process-step">
        <div class="process-number">3</div>
        <div class="process-icon">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" stroke="white" stroke-width="2"/>
          </svg>
        </div>
        <h3><%= t.servicesPage.process?.[2]?.title || 'Execute & Optimize' %></h3>
        <p><%= t.servicesPage.process?.[2]?.desc || 'We implement, monitor, and continuously improve' %></p>
      </div>
      <div class="process-step">
        <div class="process-number">4</div>
        <div class="process-icon">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10" stroke="white" stroke-width="2"/>
            <polyline points="22 4 12 14.01 9 11.01" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3><%= t.servicesPage.process?.[3]?.title || 'Deliver Results' %></h3>
        <p><%= t.servicesPage.process?.[3]?.desc || 'We report on progress and celebrate your wins' %></p>
      </div>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <h2><%= t.cta.title %></h2>
    <p><%= t.cta.subtitle %></p>
    <a href="#" onclick="openCalendly(); return false;" class="btn btn-primary btn-lg"><%= t.cta.button %></a>
  </div>
</section>
