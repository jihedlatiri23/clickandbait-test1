<section class="page-hero">
  <div class="container">
    <h1><%= t.blog.title %></h1>
    <p class="hero-subtitle"><%= t.blog.subtitle %></p>
  </div>
</section>

<section class="blog-content">
  <div class="container">
    <div class="blog-grid">
      <% t.blog.posts.forEach(function(post) { %>
      <article class="blog-card">
        <div class="blog-card-content">
          <span class="blog-date"><%= post.date %></span>
          <h2><%= post.title %></h2>
          <p><%= post.excerpt %></p>
          <a href="#" class="read-more"><%= t.blog.readMore %> &rarr;</a>
        </div>
      </article>
      <% }); %>
    </div>
  </div>
</section>
